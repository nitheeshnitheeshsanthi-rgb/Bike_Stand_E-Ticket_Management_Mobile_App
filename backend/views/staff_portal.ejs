<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>SRI APARNA - Staff Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                colors: {
                  "primary": "#a2ffbf",
                  "primary-dim": "#00ed89",
                  "surface": "#080808",
                  "on-surface": "#ffffff",
                  "surface-container": "#121212",
                  "surface-container-high": "#1a1a1a",
                  "on-surface-variant": "#94a3b8",
                  "outline": "#334155",
                },
                fontFamily: {
                  "headline": ["Outfit"],
                  "body": ["Plus Jakarta Sans"],
                },
              },
            },
          }
    </script>
    <style>
        .glass { background: rgba(18, 18, 18, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }
        .input-glow:focus { box-shadow: 0 0 20px rgba(162, 255, 191, 0.15); border-color: #a2ffbf; }
    </style>
</head>
<body class="bg-surface text-on-surface font-body min-h-screen overflow-x-hidden">
    <!-- Header -->
    <header class="fixed top-0 left-0 w-full z-50 glass px-6 py-5 flex justify-between items-center">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-primary/20 rounded-xl flex items-center justify-center">
                <span class="material-symbols-outlined text-primary font-bold">bolt</span>
            </div>
            <h1 class="font-headline text-2xl font-extrabold tracking-tight">SRI <span class="text-primary">APARNA</span></h1>
        </div>
        <div class="flex items-center gap-4">
            <div class="hidden md:flex flex-col items-end">
                <span class="text-xs font-bold uppercase tracking-widest text-primary">Active Duty</span>
                <span class="text-sm font-semibold opacity-70">Staff Portal v2.1</span>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-surface-container-high flex items-center justify-center border border-outline/30">
                <span class="material-symbols-outlined text-on-surface-variant">person</span>
            </div>
        </div>
    </header>

    <main class="pt-32 pb-20 px-6 max-w-4xl mx-auto">
        <!-- Title Section -->
        <div class="mb-12">
            <span class="text-primary font-bold uppercase tracking-[0.3em] text-[10px] mb-2 block">Registration Hub</span>
            <h2 class="text-5xl font-extrabold font-headline tracking-tighter mb-4">Generate Ticket</h2>
            <p class="text-on-surface-variant max-w-md">Enter vehicle details below to authorize a new parking session and send digital pass to customer.</p>
        </div>

        <!-- Form Card -->
        <div class="glass p-8 rounded-[2.5rem] shadow-2xl relative overflow-hidden">
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/5 rounded-full blur-3xl"></div>
            
            <form id="ticketForm" class="space-y-8 relative z-10">
                <!-- Vehicle Type -->
                <div>
                    <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-4 block">Vehicle Category</label>
                    <div class="grid grid-cols-2 gap-4">
                        <button type="button" onclick="setType('Bike')" id="btnBike" class="flex items-center justify-center gap-3 h-16 rounded-2xl border-2 border-outline/30 transition-all font-bold">
                            <span class="material-symbols-outlined">pedal_bike</span>
                            <span>Bicycle</span>
                        </button>
                        <button type="button" onclick="setType('Scooter')" id="btnScooter" class="flex items-center justify-center gap-3 h-16 rounded-2xl border-2 border-outline/30 transition-all font-bold">
                            <span class="material-symbols-outlined">moped</span>
                            <span>E-Scooter</span>
                        </button>
                    </div>
                    <input type="hidden" name="type" id="vehicleType" value="Bike">
                </div>

                <!-- Inputs -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest ml-1 block">Vehicle Number</label>
                        <input type="text" name="vehicleNumber" required placeholder="e.g. TN-09-AB-1234" 
                            class="w-full h-16 bg-surface-container rounded-2xl border-2 border-outline/20 px-6 text-lg font-bold uppercase tracking-wide input-glow transition-all outline-none">
                    </div>
                    <div class="space-y-2">
                        <label class="text-xs font-bold text-on-surface-variant uppercase tracking-widest ml-1 block">Customer WhatsApp</label>
                        <input type="tel" name="whatsappNumber" required maxlength="10" pattern="[0-9]{10}" placeholder="98765 43210" 
                            class="w-full h-16 bg-surface-container rounded-2xl border-2 border-outline/20 px-6 text-lg font-bold input-glow transition-all outline-none">
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="w-full h-20 bg-primary text-surface rounded-3xl flex items-center justify-center gap-4 group hover:scale-[1.02] active:scale-[0.98] transition-all overflow-hidden relative shadow-[0_20px_40px_rgba(162,255,191,0.2)]">
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
                    <span class="text-xl font-extrabold font-headline uppercase tracking-tighter relative z-10">Generate & Send Ticket</span>
                    <span class="material-symbols-outlined font-black relative z-10">send</span>
                </button>
            </form>
        </div>

        <!-- Success Message (Hidden) -->
        <div id="successCard" class="hidden glass p-10 rounded-[2.5rem] text-center space-y-6 border-primary/20 bg-primary/5">
            <div class="w-24 h-24 bg-primary text-surface rounded-full flex items-center justify-center mx-auto shadow-lg">
                <span class="material-symbols-outlined text-5xl font-black">check_circle</span>
            </div>
            <div>
                <h3 class="text-3xl font-black tracking-tighter mb-2">Ticket Generated!</h3>
                <p class="text-on-surface-variant">The digital pass has been sent via WhatsApp.</p>
            </div>
            <div class="flex gap-4 pt-4">
                <a id="viewTicketBtn" href="#" class="flex-1 h-14 bg-surface-container-high rounded-2xl flex items-center justify-center font-bold border border-outline/50">View Live Pass</a>
                <button onclick="resetForm()" class="flex-1 h-14 bg-primary/10 text-primary border border-primary/30 rounded-2xl font-bold">New Registration</button>
            </div>
        </div>
    </main>

    <script>
        let currentType = 'Bike';
        
        function setType(type) {
            currentType = type;
            document.getElementById('vehicleType').value = type;
            document.getElementById('btnBike').style.borderColor = type === 'Bike' ? '#a2ffbf' : 'rgba(51, 65, 85, 0.3)';
            document.getElementById('btnBike').style.backgroundColor = type === 'Bike' ? 'rgba(162, 255, 191, 0.1)' : 'transparent';
            document.getElementById('btnScooter').style.borderColor = type === 'Scooter' ? '#a2ffbf' : 'rgba(51, 65, 85, 0.3)';
            document.getElementById('btnScooter').style.backgroundColor = type === 'Scooter' ? 'rgba(162, 255, 191, 0.1)' : 'transparent';
        }

        // Initialize state
        setType('Bike');

        document.getElementById('ticketForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.innerHTML = 'Connecting to System...';
            btn.disabled = true;

            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/api/tickets/web-entry', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (response.ok) {
                    document.getElementById('ticketForm').parentElement.classList.add('hidden');
                    document.getElementById('successCard').classList.remove('hidden');
                    document.getElementById('viewTicketBtn').href = '/preview/' + result.ticket.ticketId;
                } else {
                    alert('Error: ' + (result.message || 'Failed to create ticket'));
                    btn.innerHTML = 'Generate & Send Ticket <span class="material-symbols-outlined font-black">send</span>';
                    btn.disabled = false;
                }
            } catch (err) {
                alert('System Error: ' + err.message);
                btn.innerHTML = 'Generate & Send Ticket <span class="material-symbols-outlined font-black">send</span>';
                btn.disabled = false;
            }
        });

        function resetForm() {
            document.getElementById('ticketForm').reset();
            document.getElementById('ticketForm').parentElement.classList.remove('hidden');
            document.getElementById('successCard').classList.add('hidden');
            const btn = document.querySelector('button[type="submit"]');
            btn.innerHTML = 'Generate & Send Ticket <span class="material-symbols-outlined font-black">send</span>';
            btn.disabled = false;
            setType('Bike');
        }
    </script>
</body>
</html>
