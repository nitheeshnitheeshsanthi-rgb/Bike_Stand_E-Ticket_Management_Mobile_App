<!DOCTYPE html>
<html class="dark" lang="en">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>SRI APARNA - Digital Pass</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
          tailwind.config = {
            darkMode: "class",
            theme: {
              extend: {
                colors: {
                  "primary": "#a2ffbf",
                  "primary-container": "#00fd93",
                  "surface": "#0e0e0e",
                  "on-surface": "#ffffff",
                  "surface-container": "#1a1a1a",
                  "surface-container-high": "#20201f",
                  "on-surface-variant": "#adaaaa",
                  "outline-variant": "#484847",
                },
                fontFamily: {
                  "headline": ["Manrope"],
                  "body": ["Inter"],
                },
              },
            },
          }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
</head>
<body class="bg-surface text-on-surface font-body min-h-screen">
    <header class="bg-surface flex justify-between items-center w-full px-6 py-4 sticky top-0 z-50">
        <div class="flex items-center gap-4">
            <h1 class="font-headline tracking-tighter font-bold uppercase text-2xl text-primary">SRI APARNA</h1>
        </div>
        <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center overflow-hidden">
            <span class="material-symbols-outlined text-primary">directions_bike</span>
        </div>
    </header>

    <main class="max-w-md mx-auto px-6 pt-4 pb-32">
        <div class="mb-10 pl-4">
            <span class="text-primary font-headline font-bold tracking-widest text-xs uppercase mb-2 block">
                <%= ticket.status === 'Paid' ? 'Completed Session' : 'Active Session' %>
            </span>
            <h2 class="text-on-surface font-headline text-3xl font-extrabold tracking-tighter">Your Digital Pass</h2>
        </div>

        <div class="relative">
            <div class="bg-surface-container rounded-xl overflow-hidden shadow-[0_20px_40px_rgba(162,255,191,0.05)]">
                <div class="p-8 pb-6 border-b border-white/5">
                    <div class="flex justify-between items-start mb-6">
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">Station</p>
                            <h3 class="text-on-surface font-headline text-xl font-bold">Sri Aparna Cycle and Bike Stand</h3>
                        </div>
                        <div class="bg-primary/10 px-3 py-1 rounded-full">
                            <span class="text-primary text-[10px] font-bold uppercase tracking-wider">Level 02</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-8">
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">Entry Time</p>
                            <p class="text-on-surface font-headline font-bold"><%= new Date(ticket.entryTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></p>
                        </div>
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">Vehicle</p>
                            <p class="text-on-surface font-headline font-bold uppercase"><%= ticket.type %></p>
                        </div>
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">Vehicle ID</p>
                            <p class="text-on-surface font-headline font-bold uppercase"><%= ticket.vehicleNumber %></p>
                        </div>
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">WhatsApp</p>
                            <p class="text-on-surface font-headline font-bold"><%= ticket.whatsappNumber || 'Not provided' %></p>
                        </div>
                        <div>
                            <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.2em] mb-1">Status</p>
                            <p class="text-primary font-headline font-bold"><%= ticket.status %></p>
                        </div>
                    </div>
                </div>

                <div class="bg-surface-container-high p-8 flex flex-col items-center gap-6">
                    <div class="bg-white p-4 rounded-lg">
                        <img alt="QR Code" class="w-48 h-48" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= ticket.ticketId %>"/>
                    </div>
                    <div class="text-center">
                        <p class="text-on-surface-variant text-[10px] uppercase tracking-[0.3em] mb-2">Ticket Reference</p>
                        <p class="text-on-surface font-body font-mono tracking-widest opacity-50 text-sm"># <%= ticket.ticketId %></p>
                    </div>
                </div>
            </div>
            <div class="absolute -left-2 top-1/2 -translate-y-1/2 w-4 h-8 bg-surface rounded-r-full"></div>
            <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-4 h-8 bg-surface rounded-l-full"></div>
        </div>

        <% if (ticket.status === 'Paid') { %>
        <div class="mt-8 p-6 bg-primary/10 rounded-xl border border-primary/20">
            <div class="flex justify-between items-center mb-2">
                <p class="text-on-surface font-headline font-bold text-lg">Payment Confirmed</p>
                <span class="material-symbols-outlined text-primary">verified</span>
            </div>
            <p class="text-on-surface-variant text-sm mb-4">Total Fee: ₹<%= ticket.fee %></p>
            <p class="text-primary font-bold text-xs uppercase tracking-widest">Released at <%= new Date(ticket.exitTime).toLocaleTimeString() %></p>
        </div>
        <% } %>

        <div class="mt-10 space-y-4">
            <button onclick="window.print()" class="w-full bg-gradient-to-br from-primary to-primary-container py-5 rounded-full flex items-center justify-center gap-3 active:scale-95 transition-transform text-surface font-headline font-bold uppercase tracking-widest text-sm">
                <span class="material-symbols-outlined">download</span>
                Save as PDF
            </button>
        </div>
    </main>

    <nav class="fixed bottom-0 left-0 w-full z-50 flex justify-around items-center bg-[#1a1a1a]/80 backdrop-blur-xl rounded-t-[3rem] px-4 pb-6 pt-2 shadow-[0_-20px_40px_rgba(162,255,191,0.05)]">
        <a class="flex flex-col items-center justify-center text-on-surface-variant py-2 px-4" href="/">
            <span class="material-symbols-outlined mb-1">home</span>
            <span class="text-[10px] uppercase tracking-widest font-semibold">Home</span>
        </a>
        <a class="flex flex-col items-center justify-center text-primary bg-primary/10 rounded-full py-2 px-4 shadow-[0_0_20px_rgba(162,255,191,0.1)]" href="#">
            <span class="material-symbols-outlined mb-1" style="font-variation-settings: 'FILL' 1;">confirmation_number</span>
            <span class="text-[10px] uppercase tracking-widest font-semibold">Ticket</span>
        </a>
        <a class="flex flex-col items-center justify-center text-on-surface-variant py-2 px-4" href="#">
            <span class="material-symbols-outlined mb-1">map</span>
            <span class="text-[10px] uppercase tracking-widest font-semibold">Locate</span>
        </a>
    </nav>
</body>
</html>
